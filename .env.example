# Copy to .env and fill in. .env is git-ignored.
# In paper mode you can leave broker credentials blank.

# paper | confirm | live
TRADING_MODE=paper

# Master key used to encrypt stored broker credentials (app/security.py).
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PORTAL_SECRET_KEY=

# --- Robinhood ---
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Optional TOTP secret for MFA (base32), enables non-interactive login
ROBINHOOD_MFA_SECRET=

# --- Webull ---
WEBULL_USERNAME=
WEBULL_PASSWORD=
WEBULL_TRADE_PIN=
WEBULL_DEVICE_ID=

# --- Analytic brain (Claude / Opus) ---
# Anthropic API key powers the analyst (per-symbol ratings + portfolio note).
# With no key it degrades to a transparent technical heuristic. Get one at
# https://console.anthropic.com/ . The Anthropic host is reachable from web
# sessions, so this works both locally and in Claude Code on the web.
ANTHROPIC_API_KEY=
PORTAL_LLM_MODEL=claude-opus-5

# --- Optional: live event monitoring via xAI Grok (live search of X/web) ---
# Not required — the analyst uses Claude. Leave blank to skip Grok entirely.
XAI_API_KEY=
XAI_MODEL=grok-4

# Direct X.com / Twitter API v2 (OPTIONAL, paid tier) — for raw post-level
# sentiment. Grok live-search is the cheaper default; leave blank to skip.
X_BEARER_TOKEN=

# Web server
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8000
